# BookBay backend configuration
APP_NAME=BookBay
APP_ENV=local
APP_DEBUG=true

# --- Database ------------------------------------------------------------
# Primary driver is MySQL.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookbay
DB_USERNAME=root
DB_PASSWORD=

# No MySQL server handy? Switch to SQLite for local development / smoke tests:
# DB_DRIVER=sqlite
# DB_DATABASE=/absolute/path/to/bookbay/database/bookbay.sqlite

# --- CORS ----------------------------------------------------------------
# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis (optional) -----------------------------------------------------
# When REDIS_HOST is set and the phpredis extension is loaded, the rate
# limiter uses Redis (required for multi-process deployments). Otherwise it
# falls back to in-memory counting.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# --- Sessions ------------------------------------------------------------
# Auth token TTL in seconds (default: 30 days).
SESSION_TTL=2592000
